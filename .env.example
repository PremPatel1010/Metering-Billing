# Server
PORT=3000

# PostgreSQL
DATABASE_URL="postgresql://postgres:hello_world@localhost:5432/billing_db"

# Stripe test mode (get these from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY="sk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
STRIPE_PRO_PRICE_ID="price_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
STRIPE_WEBHOOK_SECRET="whsec_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# Stripe Checkout redirect URLs (used after success/cancel)
STRIPE_SUCCESS_URL="http://localhost:3000/success"
STRIPE_CANCEL_URL="http://localhost:3000/cancel"

# Background job: monthly usage rollup interval (ms). 0/off disables it. Default 60000.
JOB_INTERVAL_MS=60000